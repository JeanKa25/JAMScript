#!/bin/bash

show_usage() {
    cat <<EOF
JAMTools - Docker Batch Runner

Usage: djambatch [OPTIONS] program.jxe

Options:
    --help                      Show this help message
    --fog=numProg1-programName1,numProg2-programName2
    --device=numProg1-programName1,numProg2-programName2
    --cloud=numProg1-programName1,numProg2-programName2
    --cFile=cloudProg1File,cloudProg2File
    --fFile=fogProg1File,fogProg2File
    --dFile=deviceProg1File,deviceProg2File
    --num=cNumProg1,cNumProg2
    --cLoc=long1,lat1-long2,lat2
    --fLoc=long1,lat1-long2,lat2
    --dLoc=long1,lat1-long2,lat2
    --cEdge=edge1,edge2
    --fEdge=edge1,edge2
    --dEdge=edge1,edge2

Examples:
djambatch program.jxe --fog=2-XX,3-X --fFile=1-jt2.jxe,2-jt3.jxe,2-jt4.jxe --fLoc=300,300-400,400 --fEdge=1
djambatch program.jxe --cloud=2-XX,3-X --cFile=1-jt2.jxe,2-jt3.jxe,2-jt4.jxe --cLoc=300,300-400,400 --cEdge=1
djambatch program.jxe --device=2-XX,3-X --dFile=1-jt2.jxe,2-jt3.jxe,2-jt4.jxe --dLoc=300,300-400,400 --dEdge=1 --num=2,3,1
EOF
}

declare -A args
declare -a command_queue

validate_counts() {
    local layer=$1
    local total_entries=0
    local total_files=0
    
    IFS=',' read -ra entries <<< "${args[$layer]}"
    for entry in "${entries[@]}"; do
        count="${entry%-*}"
        total_entries=$((total_entries + count))
    done

    IFS=',' read -ra files <<< "${args[${layer:0:1}File]}"
    for file in "${files[@]}"; do
        count="${file%%-*}"
        total_files=$((total_files + count))
    done

    [[ $total_entries -eq $total_files ]] || {
        echo "Error: ${layer} count mismatch (entries: $total_entries vs files: $total_files)"
        exit 1
    }
}

process_layer() {
    local layer=$1
    local prefix=${layer:0:1}
    
    [[ -n "${args[$layer]}" ]] || return 0
    
    validate_counts "$layer"

    declare -a entries locations edges files nums
    IFS=',' read -ra entries <<< "${args[$layer]}"
    IFS=',' read -ra files <<< "${args[${prefix}File]}"
    IFS='-' read -ra locations <<< "${args[${prefix}Loc]}"
    IFS=',' read -ra edges <<< "${args[${prefix}Edge]}"
    IFS=',' read -ra nums <<< "${args[num]}"

    local file_ptr=0 loc_ptr=0 edge_ptr=0 num_ptr=0

    for entry in "${entries[@]}"; do
        IFS='-' read count app <<< "$entry"
        for ((i=0; i<count; i++)); do
            IFS='-' read fcount fname <<< "${files[$file_ptr]}"
            
            for ((j=0; j<fcount; j++)); do
                cmd="djamrun $fname --app=$app --bg --log --$layer"
                
                if [[ -n "${locations[$loc_ptr]}" ]]; then
                    cmd+=" --loc=${locations[$loc_ptr]}"
                    ((loc_ptr++))
                fi

                if [[ -n "${edges[$edge_ptr]}" ]]; then
                    cmd+=" --edge=${edges[$edge_ptr]}"
                    ((edge_ptr++))
                fi

                if [[ $layer == "device" && -n "${nums[$num_ptr]}" ]]; then
                    cmd+=" --num=${nums[$num_ptr]}"
                    ((num_ptr++))
                fi

                command_queue+=("$cmd")
            done
            ((file_ptr++))
        done
    done
}

# Argument parsing
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)
            show_usage
            exit 0
            ;;
        --*=*)
            key="${1%%=*}"
            key="${key#--}"
            args["$key"]="${1#*=}"
            ;;
        *.jxe)
            args[file]="$1"
            ;;
        *)
            echo "Invalid option: $1" >&2
            exit 1
            ;;
    esac
    shift
done

[[ -n "${args[file]}" ]] || {
    echo "Error: No JXE file specified" >&2
    exit 1
}

# Process each layer type
process_layer "fog"
process_layer "cloud"
process_layer "device"

# Execute commands sequentially
for cmd in "${command_queue[@]}"; do
    echo "Running: $cmd"
    eval "$cmd"
done
